#!/bin/sh
set -eu

if [ "${1:-}" = "--clusterforge-plugin-info" ]; then
  printf '%s\n' '{"name":"hello","version":"0.1.0","description":"Example trusted local ClusterForge plugin","commands":["greet"],"capabilities":["template"]}'
  exit 0
fi

if [ "${1:-}" = "greet" ]; then
  shift
  printf 'hello%s\n' "${1:+, $1}"
  exit 0
fi

printf '%s\n' 'usage: cf plugin run hello -- greet [name]' >&2
exit 2
